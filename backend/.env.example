APP_NAME=DevGPT API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
MAX_CONTEXT_TOKENS=3000
MAX_TOOL_OUTPUT_CHARS=4000
REQUIRE_CLIENT_ID=true
CLOSE_GRACE_SECONDS=45
IDLE_TIMEOUT_MINUTES=10
CHAT_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=60
ENABLE_CLEANUP_TASK=true

# POSTGRESQL DATABASE CONFIGURATION
# Generate with: python backend/scripts/generate_secrets.py
SECRET_KEY=Your Secret Key Here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=devgpt
POSTGRES_USER=devgpt
POSTGRES_PASSWORD=replace-with-a-generated-local-password


# GOOGLE GEMINI API KEY - USED ONLY FOR DOCUMENT EMBEDDINGS
GOOGLE_API_KEY=Your Google Gemini API Key Here

# GROQ CHAT MODEL CONFIGURATION
GROQ_API_KEY=Your Groq API Key Here
GROQ_MODEL="openai/gpt-oss-120b"

# TAVILY CONFIGURATION FOR KNOWING ABOUT PLACES
TAVILY_API_KEY=Your Tavily API Key Here

# WEATHER API KEY USED FOR GETTING WEATHER INFORMATION FROM WEATHERAPI.COM
WEATHER_API_KEY=Your WeatherAPI.com Key Here

# OPTIONAL LEGACY WEATHER PROVIDER FALLBACK
OPENWEATHER_API_KEY=

# ALPHA VANTAGE API KEY FOR GETTING STOCK MARKET INFORMATION
ALPHA_VANTAGE_API_KEY=Your Alpha Vantage API Key Here

# OPTIONAL LEGACY STOCK PROVIDER FALLBACK
FINNHUB_API_KEY=


# LANGSMITH CONFIGURATION
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=Your LangSmith API Key Here
LANGSMITH_PROJECT_NAME="DevGPT"


# CHAT "+" MENU INTEGRATIONS (all optional)
# Vision model that reads attached photos and sketches (Groq).
VISION_MODEL="qwen/qwen3.8-27b"
MAX_IMAGE_MB=4
# Text-to-image service for "Create image"; {prompt} and {seed} are filled in.
IMAGE_GENERATION_URL="https://image.pollinations.ai/prompt/{prompt}?width=1024&height=1024&nologo=true&seed={seed}"
# Context budget for "Deep research" (several web searches per answer).
DEEP_RESEARCH_CONTEXT_TOKENS=8000
# GitHub personal access token: private repos, higher limits, publishing issues/comments.
GITHUB_TOKEN=
# Figma personal access token for reading design files.
FIGMA_TOKEN=
